+def fuse_search_results(params: dict[str, str]) -> None:
+    """Render a non-interactive Movie or Series search for Arctic Fuse."""
+
+    handle = int(sys.argv[1])
+    item_type = fuse_search_item_type(params.get("item_type"))
+    content_type = "movies" if item_type == "Movie" else "tvshows"
+    xbmcplugin.setContent(handle, content_type)
+
+    query = params.get("query")
+    if item_type is None or not query or not is_fuse_search_query_valid(query):
+        xbmcplugin.endOfDirectory(handle, cacheToDisc=False)
+        return
+
+    settings = xbmcaddon.Addon()
+    progress = None
+    if settings.getSetting("showLoadProgress") == "true":
+        progress = xbmcgui.DialogProgress()
+        progress.create(string_load(30112))
