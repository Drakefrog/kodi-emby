+def __enrich_url(param_url: str, params: dict[str, str]) -> str:
+    enriched_url = param_url
+    parent_id = __get_parent_id_from(params)
+    if parent_id is not None:
+        enriched_url = param_url + "&ParentId=" + parent_id
+    return enriched_url
