+            "&IncludePeople=false",
+            "&IncludeMedia=true",
+            "&IncludeGenres=false",
+            "&IncludeStudios=false",
+            "&IncludeArtists=false",
+            "&IncludeItemTypes=" + item_type,
+            "&Limit=12",
+            "&Fields={field_filters}",
+            "&Recursive=true",
+            "&EnableTotalRecordCount=false",
+            "&ImageTypeLimit=1",
+        ]
+    )
+
+    try:
+        # process_directory delegates item retrieval to DataManager, including
+        # its existing on-disk cache when use_cache_data is enabled.
+        _render_search_directory(search_url, progress, params, content_type, True)
+    finally:
+        if progress is not None:
+            progress.update(100, string_load(30125))
