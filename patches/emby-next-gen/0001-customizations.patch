+def get_client_authorization(DeviceId, UserId="", AccessToken=""):
+    """Build the Emby authorization identity used by Infuse Direct.
+
+    Emby accepts the MediaBrowser authorization format in
+    ``X-Emby-Authorization``.  Keeping this in one place is important: a
+    connection can be opened before authentication and updated after a token
+    is received, while both stages must advertise the same client.
+    """
+    Authorization = []
+
+    if UserId:
+        Authorization.append(f'UserId="{UserId}"')
+
+    if AccessToken:
+        Authorization.append(f'Token="{AccessToken}"')
+
+    Authorization.extend((
+        f'Client="{ClientName}"',
+        f'Device="{device_name}"',
+        f'DeviceId="{DeviceId}"',
+        f'Version="{ClientVersion}"',
+    ))
+
+    return f"MediaBrowser {', '.join(Authorization)}"
+
+
+def get_legacy_client_authorization(DeviceId, UserId="", AccessToken=""):
+    """Build the legacy Authorization form for older Emby server versions."""
+    return get_client_authorization(DeviceId, UserId, AccessToken).replace("MediaBrowser ", "Emby ", 1)
+
