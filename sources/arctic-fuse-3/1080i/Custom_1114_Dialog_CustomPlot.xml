<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1114">

    <defaultcontrol always="true">9001</defaultcontrol>
    <onunload>ClearProperty(header,1114)</onunload>
    <onunload>ClearProperty(textbox,1114)</onunload>
    <onunload>ClearProperty(poster,1114)</onunload>
    <onunload>ClearProperty(landscape,1114)</onunload>
    <onunload>ClearProperty(clearlogo,1114)</onunload>
    <onunload>ClearProperty(icon,1114)</onunload>
    <onunload>ClearProperty(path,1114)</onunload>
    <onunload>ClearProperty(trailer,1114)</onunload>
    <onunload>ClearProperty(tmdb_id,1114)</onunload>
    <onunload>ClearProperty(tmdb_type,1114)</onunload>
    <onunload>ClearProperty(season,1114)</onunload>
    <onunload>ClearProperty(episode,1114)</onunload>
    <onunload>ClearProperty(filenameandpath,1114)</onunload>
    <onunload>ClearProperty(folderpath,1114)</onunload>
    <onunload>ClearProperty(dbtype,1114)</onunload>
    <onunload>ClearProperty(origin_tmdb_id,1114)</onunload>
    <onunload>ClearProperty(origin_tmdb_type,1114)</onunload>
    <onunload>ClearProperty(origin_season,1114)</onunload>
    <onunload>ClearProperty(origin_episode,1114)</onunload>
    <onunload>ClearProperty(emby_source,1114)</onunload>
    <onunload>ClearProperty(emby_person_id,1114)</onunload>
    <onunload>ClearProperty(emby_item_id,1114)</onunload>
    <onunload>ClearProperty(emby_item_type,1114)</onunload>
    <onunload>ClearProperty(emby_person_request,1114)</onunload>
    <onunload>ClearProperty(emby_person_pending,1114)</onunload>
    <onunload>ClearProperty(emby_person_id,Home)</onunload>
    <onunload>ClearProperty(emby_person_request,Home)</onunload>
    <onunload>ClearProperty(emby_person_pending,Home)</onunload>
    <onunload>ClearProperty(emby_person_header,Home)</onunload>
    <onunload>ClearProperty(emby_person_textbox,Home)</onunload>
    <onunload>ClearProperty(emby_person_poster,Home)</onunload>
    <onload>SetProperty(TMDbHelper.ContextMenu,True)</onload>
    <controls>

        <include content="Object_Hidden_List" condition="!String.IsEqual(Window.Property(emby_source),emby) + !String.IsEmpty(Window.Property(tmdb_type)) + !String.IsEmpty(Window.Property(tmdb_id)) + String.IsEmpty(Window.Property(textbox))">
            <param name="id">7000</param>
            <content limit="1">$INFO[Window.Property(tmdb_id),plugin://plugin.video.themoviedb.helper/?info=details&amp;tmdb_id=,]$INFO[Window.Property(tmdb_type),&amp;tmdb_type=,]</content>
        </include>

        <!-- Emby people are intentionally isolated from TMDb's detail provider. -->
        <include content="Object_Hidden_List" condition="String.IsEqual(Window.Property(emby_source),emby) + !String.IsEmpty(Window(Home).Property(emby_person_id)) + !String.IsEmpty(Window(Home).Property(emby_person_pending))">
            <param name="id">7002</param>
            <content limit="1">plugin://plugin.video.embycon/?mode=DETAIL_PERSON&amp;id=$INFO[Window(Home).Property(emby_person_id)]&amp;request_id=$INFO[Window(Home).Property(emby_person_request)]</content>
        </include>

        <include content="Object_Hidden_Button" condition="String.IsEmpty(Window.Property(path))">
            <param name="id">9001</param>
            <onleft>Close</onleft>
            <onclick>Close</onclick>
            <onup>Control.Message(61,pageup)</onup>
            <ondown>Control.Message(61,pagedown)</ondown>
        </include>

        <include content="DialogCustomPlot" condition="![!String.IsEmpty(Window.Property(poster)) | !String.IsEmpty(Window.Property(icon))]">
            <param name="include_artwork">false</param>
        </include>
        <include content="DialogCustomPlot" condition="!String.IsEmpty(Window.Property(poster)) | !String.IsEmpty(Window.Property(icon))">
            <param name="include_artwork">true</param>
        </include>

        <include content="Furniture_Busy" condition="[!String.IsEqual(Window.Property(emby_source),emby) + !String.IsEmpty(Window.Property(tmdb_type)) + !String.IsEmpty(Window.Property(tmdb_id)) + String.IsEmpty(Window.Property(textbox))] | [String.IsEqual(Window.Property(emby_source),emby) + !String.IsEmpty(Window(Home).Property(emby_person_pending))]">
            <param name="hasspinner">true</param>
            <param name="spinspinner">true</param>
            <param name="icon">special://skin/extras/icons/kodi.png</param>
            <param name="spinnervisible">[!Window.IsActive(DialogVolumeBar.xml) | Player.Muted]</param>
            <param name="haslabel">false</param>
            <param name="visible_delay">800</param>
            <param name="windowopen_delay">800</param>
            <param name="visible">[[!Window.IsActive(DialogVolumeBar.xml) | Player.Muted] + [[!String.IsEqual(Window.Property(emby_source),emby) + !String.IsEmpty(Window.Property(tmdb_type)) + !String.IsEmpty(Window.Property(tmdb_id)) + [Container(7000).IsUpdating | [Container(7001).IsUpdating + !String.IsEmpty(Window.Property(ModePath))]]] | [String.IsEqual(Window.Property(emby_source),emby) + [Container(7002).IsUpdating | !String.IsEmpty(Window(Home).Property(emby_person_pending))]]]]</param>
        </include>

    </controls>
</window>
